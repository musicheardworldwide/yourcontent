# YourContent settings for docker compose. Copy this file to .env (it is gitignored) and edit the three lines below.
# Everything else works without changes. The full list of settings is in the README ("Configure").
#
#   cp .env.example .env

# 1. Where your ComfyUI answers, as seen from inside the container. host.docker.internal is this computer.
#    If `docker compose exec app python3 -m medialab check` says it cannot reach ComfyUI, see the README (Quick start).
YOURCONTENT_COMFY_URL=http://host.docker.internal:8188

# 2. ComfyUI's own output/ folder. YourContent reads finished pictures, clips and music from here and puts its
#    files in output/yourcontent/.
COMFY_OUTPUT_DIR=/path/to/ComfyUI/output

# 3. A subfolder of ComfyUI's input/ folder, named media_lab (create it: mkdir -p /path/to/ComfyUI/input/media_lab).
#    Uploads and picture-to-clip inputs go here so ComfyUI can load them.
COMFY_UPLOADS_DIR=/path/to/ComfyUI/input/media_lab

# Only if you named the input/ subfolder something other than media_lab:
#YOURCONTENT_INPUT_SUBDIR=media_lab
