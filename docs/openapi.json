  "/api/calendar": {
   "get": {
    "operationId": "get_api_calendar",
    "summary": "Content calendar entries between two dates (YYYY-MM-DD).",
    "responses": {
     "200": {
      "description": "JSON"
     },
     "4XX": {
      "description": "{\"error\": message}"
     }
    }
   },
   "post": {
    "operationId": "post_api_calendar",
    "summary": "Add a calendar entry. Put finished work on it with status 'ready' and the file as asset.",
    "responses": {
     "200": {
      "description": "JSON"
     },
     "4XX": {
      "description": "{\"error\": message}"
     }
    },
    "parameters": [
     {
      "name": "X-Media-Lab",
      "in": "header",
      "required": true,
      "schema": {
       "const": "1"
      },
      "description": "required on every POST except /mcp"
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "when": {
          "type": "string",
          "description": "YYYY-MM-DD (all day) or YYYY-MM-DDTHH:MM[+offset]"
         },
         "duration_min": {
          "type": "integer"
         },
         "channel": {
          "type": "string",
          "description": "e.g. instagram_reel"
         },
         "title": {
          "type": "string"
         },
         "caption": {
          "type": "string"
         },
         "status": {
          "enum": [
           "idea",
           "draft",
           "ready",
           "posted",
           "skipped"
          ]
         },
         "project": {
          "type": "string"
         },
         "asset": {
          "type": "object",
          "description": "a file reference as returned by list_media: {root, name}",
          "properties": {
           "root": {
            "type": "string"
           },
           "name": {
            "type": "string"
           }
          },
          "required": [
           "root",
           "name"
          ]
         }
        },
        "additionalProperties": false,
        "required": [
         "when",
         "title"
        ]
       }
      }
     }
    }
   }
