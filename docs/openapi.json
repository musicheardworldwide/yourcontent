  "/api/animate": {
   "post": {
    "operationId": "post_api_animate",
    "summary": "Start a clip job that animates a picture (3 or 5 seconds).",
    "responses": {
     "200": {
      "description": "JSON"
     },
     "4XX": {
      "description": "{\"error\": message}"
     }
    },
    "parameters": [
     {
      "name": "X-Media-Lab",
      "in": "header",
      "required": true,
      "schema": {
       "const": "1"
      },
      "description": "required on every POST except /mcp"
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "start": {
          "type": "object",
          "description": "a file reference as returned by list_media: {root, name}",
          "properties": {
           "root": {
            "type": "string"
           },
           "name": {
            "type": "string"
           }
          },
          "required": [
           "root",
           "name"
          ]
         },
         "prompt": {
          "type": "string"
         },
         "seconds": {
          "enum": [
           3,
           5
          ]
         },
         "quality": {
          "enum": [
           "480p",
           "720p"
          ]
         },
         "seed": {
          "type": "integer"
         }
        },
        "additionalProperties": false,
        "required": [
         "start"
        ]
       }
      }
     }
    }
   }
  },
